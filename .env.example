# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Resend API key
RESEND_API_KEY="re_xxxxxxxx"

# Email where lead notifications are delivered
LEAD_NOTIFY_EMAIL="you@example.com"

# Salt for hashing IP addresses
LEAD_HASH_SALT="a-long-random-string"

# Secret passcode for accessing /leads dashboard
LEADS_ADMIN_PASSWORD="set-your-secret-password-here"

# Cal.com or scheduling booking link (for 15-min chat)
NEXT_PUBLIC_CAL_URL="https://cal.com/orvilyn/15min"
